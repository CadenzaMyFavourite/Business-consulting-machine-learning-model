# Example environment variables for Smart Analytics & Task Management Platform

# SQLite database file (or a PostgreSQL URL like: postgresql://user:pass@localhost:5432/dbname)
DATABASE_URL=sqlite:///./app.db

# JWT secret key (change in production)
JWT_SECRET=shh_super_secret

# Comma-separated origins allowed to call the backend directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
